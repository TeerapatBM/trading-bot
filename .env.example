# Copy this file to .env. Never share .env or data/.
BIND_HOST=127.0.0.1
PORT=8899
# Optional: leave blank to generate data/dashboard-token.txt automatically.
# DASHBOARD_TOKEN=replace-with-at-least-24-random-characters
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Full path is optional if MT5 is detected automatically.
# MT5_PATH=C:\Program Files\XM MT5\terminal64.exe
ALLOW_LIVE_TRADING=false
